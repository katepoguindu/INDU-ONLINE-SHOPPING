<%- include('partials', {title:'My Orders | INDU ONLINE SHOPPING'}) %><div class="eyebrow">PURCHASE HISTORY</div><h2 class="section-title">My Orders</h2><div class="panel"><% if(!orders.length){ %>No orders placed yet. <a href="/"><u>Start shopping</u></a><% } else { %><table><thead><tr><th>Order ID</th><th>Order Date</th><th>Total Amount</th><th>Status</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.order_id %></td><td><%= new Date(o.order_date).toLocaleDateString('en-IN') %></td><td>₹<%= Number(o.total_amount).toFixed(2) %></td><td><span class="tag"><%= o.status %></span></td></tr><% }) %></tbody></table><% } %></div><%- include('footer') %>

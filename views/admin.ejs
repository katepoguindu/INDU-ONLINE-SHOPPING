<%- include('partials', {title:'Admin | INDU ONLINE SHOPPING'}) %><div class="eyebrow">ADMIN DASHBOARD</div><h2 class="section-title">Manage Products & Stock</h2><div class="stats"><div class="stat"><span class="muted">Users</span><strong><%= stats.users %></strong></div><div class="stat"><span class="muted">Products</span><strong><%= stats.products %></strong></div><div class="stat"><span class="muted">Orders</span><strong><%= stats.orders %></strong></div></div>
<section class="panel"><h3>Add New Product</h3><form class="admin-form" method="POST" action="/admin/products/add"><div><label>Product Name</label><input name="product_name" required></div><div><label>Category</label><input name="category"></div><div><label>Price (₹)</label><input type="number" name="price" min="0" step="0.01" required></div><div><label>Stock</label><input type="number" name="stock" min="0" step="1" required></div><div class="full"><label>Description</label><textarea name="description" rows="2"></textarea></div><div class="full"><button type="submit">Add Product</button></div></form></section>
<h3 style="margin-top:30px">Existing Products</h3><div class="grid"><% products.forEach(p=>{ %><section class="card"><form method="POST" action="/admin/products/update/<%= p.products_id %>"><label>Product Name</label><input name="product_name" value="<%= p.product_name %>" required><label>Category</label><input name="category" value="<%= p.category %>"><label>Price</label><input type="number" name="price" min="0" step="0.01" value="<%= p.price %>" required><label>Stock</label><input type="number" name="stock" min="0" value="<%= p.stock %>" required><label>Description</label><textarea name="description" rows="2"><%= p.description %></textarea><button type="submit">Update Product</button></form><form method="POST" action="/admin/products/delete/<%= p.products_id %>" style="margin-top:9px" onsubmit="return confirm('Delete this product?')"><button class="danger" type="submit">Delete Product</button></form></section><% }) %></div><%- include('footer') %>

<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title || 'INDU ONLINE SHOPPING' %></title><link rel="stylesheet" href="/style.css"></head><body>
<header class="nav"><a class="brand" href="/">INDU <span>ONLINE SHOPPING</span></a><nav class="navlinks">
<a href="/">Home</a>
<% if (currentUser) { %><a href="/cart">My Cart</a><a href="/orders">My Orders</a><% if(currentUser.role==='admin'){ %><a href="/admin">Admin</a><% } %><span class="muted">Hi, <%= currentUser.name %></span><form method="POST" action="/logout"><button class="secondary" type="submit">Logout</button></form><% } else { %><a href="/login">Login</a><a href="/register">Register</a><% } %>
</nav></header>
<main class="container"><% if (notice) { %><div class="notice"><%= notice %></div><% } %>

<%- include('partials', {title:'My Cart | INDU ONLINE SHOPPING'}) %><div class="eyebrow">YOUR SELECTION</div><h2 class="section-title">Shopping Cart</h2>
<% if(!items.length){ %><div class="panel">Your cart is empty. <a href="/"><u>Browse products</u></a></div><% } else { %><div class="panel"><table><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th>Action</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><strong><%= i.product_name %></strong><div class="muted">Available: <%= i.stock %></div></td><td>₹<%= Number(i.price).toFixed(2) %></td><td><form class="inline" method="POST" action="/cart/update/<%= i.cart_id %>"><input type="number" name="quantity" min="1" max="<%= i.stock %>" value="<%= i.quantity %>"><button class="secondary" type="submit">Update</button></form></td><td>₹<%= Number(i.subtotal).toFixed(2) %></td><td><form method="POST" action="/cart/remove/<%= i.cart_id %>"><button class="danger" type="submit">Remove</button></form></td></tr><% }) %></tbody></table><h2 style="text-align:right">Total: ₹<%= total.toFixed(2) %></h2><form method="POST" action="/orders/place" style="text-align:right"><button type="submit">Place Order</button></form></div><% } %><%- include('footer') %>
